def merge_sort_llamada(merge_sort_funcion, arr):
    """
    Soporta:
      merge sort(arr, 0, n-1) in-place
      merge sort(arr) -> (nuevo) o None (in-place)
    """
    try:
        merge_sort_funcion(arr, 0, len(arr) - 1)
        return arr
    except TypeError:
        out = merge_sort_funcion(arr)
        return out if out is not None else arr


def conteo_multiconjunto(seq):
    """Conteo tipo multiconjunto sin librerías."""
    d = {}
    for x in seq:
        d[x] = d.get(x, 0) + 1
    return d


def Caso_1(merge):
    """
    Caso 1:
    Entrada: arr=[2,1], merge(0,0,1)
    Esperado: [1,2]
    """
    arr = [2, 1]
    merge(arr, 0, 0, 1)  # L=[2], R=[1]
    assert arr == [1, 2], (
        "Caso 1: merge() falló con subarreglo izquierdo instancia unica. "
        "Posible off-by-one en n1=(medio-inicio+1) o en copias/remanentes."
    )


def Caso2(merge_sort):
    """
    Caso 2: detecta bug en cálculo del punto medio ( / en Py3 => float) que puede causar pérdida de elementos.
    Entrada: tamaño impar fuerza mid no entero si usan '/'.
    Verifica orden + integridad (no pierde/duplica).
    """
    arr = [5, 4, 3, 2, 1]
    original = arr[:]

    out = merge_sort_llamada(merge_sort, arr[:])

    assert out == [1, 2, 3, 4, 5], (
        "Caso 2: merge_sort() no ordenó correctamente en tamaño impar; "
        "posible bug de mid (usar / en vez de //) o rangos recursivos mal definidos."
    )
    assert conteo_multiconjunto(out) == conteo_multiconjunto(original), (
        "Caso 2: merge_sort() perdió o duplicó elementos; "
        "esto suele ocurrir cuando el punto medio produce particiones con huecos/solapes."
    )


def Caso3(merge_sort):
    """
    Caso 3: estabilidad con tuplas (puntaje,titulo) con puntaje igual.
    Requisito: si el criterio de ordenación es el puntaje, entonces para puntajes iguales
    el orden relativo ORIGINAL debe preservarse: 'A-first' antes que 'B-second'.
    """
    arr = [
        (10, "A-first"),
        (5,  "X"),
        (10, "B-second"),
        (7,  "Y"),
    ]

    out = merge_sort_llamada(merge_sort, arr[:])

    expected = [
        (5,  "X"),
        (7,  "Y"),
        (10, "A-first"),
        (10, "B-second"),
    ]

    assert out == expected, (
        "Caso 3: inestabilidad detectada con puntajes iguales. "
        "Causas típicas: en merge() elegir del lado derecho en empate (usar '<' en vez de '<='), "
        "o comparar tuplas completas y reordenar por 'titulo' en lugar de preservar estabilidad."
    )


def Caso4(merge):
    """
    Caso 4: revela si los arreglos auxiliares en merge() se crean/copian bien cuando inicio != 0.
    Probamos un merge interno: arr[2..5] contiene dos mitades ya ordenadas:
      L = [1,3] (2..3) y R=[2,4] (4..5)
    Esperado: solo se reordena ese segmento, sin corromper prefijo/sufijo.
    """
    arr = [99, 98, 1, 3, 2, 4, 97]
    merge(arr, inicio=2, medio=3, fin=5)
    assert arr == [99, 98, 1, 2, 3, 4, 97], (
        "Caso 4: merge() falló con inicio != 0. "
        "Causas típicas: auxiliares creados desde índice 0 en vez de 'inicio', "
        "o escritura de vuelta con k=0 en vez de k=inicio."
    )


