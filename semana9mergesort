@dataclass(frozen=True)
class RegistroStreamMX:
    """
    Estructura mínima para el experimento:
    - id: para rastrear el orden relativo (necesario para probar estabilidad).
    - fecha_estreno: clave cronológica (primera ordenación).
    - puntaje: clave del ranking (segunda ordenación).
    """
    id: int
    fecha_estreno: date
    puntaje: float
    titulo: str


def _ids_por_puntaje_en_orden(registros: list[RegistroStreamMX]) -> dict[float, list[int]]:
    """Agrupa los IDs por puntaje respetando el orden actual en la lista."""
    grupos = defaultdict(list)
    for r in registros:
        grupos[r.puntaje].append(r.id)
    return dict(grupos)


def _assert_estabilidad_preservada(antes: list[RegistroStreamMX],
                                  despues: list[RegistroStreamMX]) -> None:
    """
    Verificación automática (aserción):
    Para cada puntaje con duplicados, la secuencia de IDs debe ser la misma
    antes y después del sort por puntaje.
    """
    ids_antes = _ids_por_puntaje_en_orden(antes)
    ids_despues = _ids_por_puntaje_en_orden(despues)

    for puntaje, seq_antes in ids_antes.items():
        if len(seq_antes) > 1:  # solo importan los empates
            assert seq_antes == ids_despues.get(puntaje, []), (
                f"Estabilidad rota para puntaje={puntaje}\n"
                f"antes:   {seq_antes}\n"
                f"después: {ids_despues.get(puntaje, [])}"
            )


def selection_sort_inestable(registros: list[RegistroStreamMX],
                             key: Callable[[RegistroStreamMX], float],
                             reverse: bool = False) -> list[RegistroStreamMX]:
    """
    Selection sort para CONTRASTE.
    Teóricamente, selection sort NO es estable: un swap puede mover elementos empatados.
    Implementación: en empates, elegimos el candidato de más a la derecha para inducir
    reordenamientos y evidenciar la inestabilidad con más probabilidad.
    """
    a = registros[:]  # copia
    n = len(a)

    for i in range(n):
        sel = i
        for j in range(i + 1, n):
            kj = key(a[j])
            ks = key(a[sel])

            if reverse:
                if kj > ks or (kj == ks and j > sel):
                    sel = j
            else:
                if kj < ks or (kj == ks and j > sel):
                    sel = j

        a[i], a[sel] = a[sel], a[i]  # swap => rompe estabilidad en ciertos casos

    return a


def experimento_streammx_estabilidad():
    """
    Experimento:
    1) Ordenar por fecha ascendente (más antiguo -> más nuevo). (Paso 1 StreamMX)
    2) Ordenar por puntaje desc (mayor -> menor) usando Merge Sort estable. (Paso 2)
    3) Verificar con aserción que empates de puntaje conservan el orden cronológico.
    4) Contrastar con un algoritmo inestable (selection sort).
    """
    # Dataset con empates (misma puntuación pero distinta fecha)
    registros = [
        RegistroStreamMX(1, date(2018, 5, 1),  9.5, "Pelicula_C"),
        RegistroStreamMX(2, date(2020, 6, 10), 9.5, "Pelicula_E"),
        RegistroStreamMX(3, date(2023, 7, 20), 9.5, "Pelicula_G"),

        RegistroStreamMX(4, date(2010, 1, 1),  8.0, "Pelicula_A"),
        RegistroStreamMX(5, date(2022, 12, 1), 8.0, "Pelicula_F"),

        RegistroStreamMX(6, date(2011, 9, 9),  7.2, "Pelicula_B"),
        RegistroStreamMX(7, date(2019, 3, 15), 7.2, "Pelicula_D"),
        RegistroStreamMX(8, date(2024, 2, 2),  7.2, "Pelicula_H"),

        RegistroStreamMX(9, date(2016, 8, 8),  9.1, "Pelicula_I"),  # puntaje único
    ]

    # Paso 1: cronológico
    cronologico = sorted(registros, key=lambda r: r.fecha_estreno)
    print("PASO 1 (orden por fecha ascendente):")
    for r in cronologico:
        print((r.titulo, r.puntaje, r.fecha_estreno, r.id))

    grupos_antes = _ids_por_puntaje_en_orden(cronologico)

    # Paso 2: ranking por puntaje desc con Merge Sort estable
    estable = cronologico[:]  # copiamos para no destruir el cronológico
    # Truco: como merge_sort_key ordena ascendente, usamos -puntaje para simular desc.
    merge_sort_key(estable, 0, len(estable) - 1, key=lambda r: -r.puntaje)

    print("\nPASO 2 (orden por puntaje desc con Merge Sort ESTABLE):")
    for r in estable:
        print((r.titulo, r.puntaje, r.fecha_estreno, r.id))

    # Aserción: estabilidad preservada
    _assert_estabilidad_preservada(cronologico, estable)

    print("\nVerificación de estabilidad (solo puntajes con empates):")
    grupos_despues = _ids_por_puntaje_en_orden(estable)
    for p in sorted(grupos_antes.keys(), reverse=True):
        if len(grupos_antes[p]) > 1:
            print(f"puntaje={p}: antes={grupos_antes[p]} después={grupos_despues[p]}")

    # Contraste con algoritmo inestable
    inestable = selection_sort_inestable(cronologico, key=lambda r: r.puntaje, reverse=True)
    print("\nCONTRASTE (orden por puntaje desc con algoritmo INESTABLE):")
    for r in inestable:
        print((r.titulo, r.puntaje, r.fecha_estreno, r.id))

    try:
        _assert_estabilidad_preservada(cronologico, inestable)
        print("\n[ALERTA] En este dataset el sort inestable no rompió la estabilidad (puede pasar por coincidencia).")
        print("        Si ocurre, agrega más empates o cambia el orden de entrada.")
    except AssertionError as e:
        print("\n[OK] Se demostró ruptura de estabilidad con algoritmo inestable:")
        print(e)


