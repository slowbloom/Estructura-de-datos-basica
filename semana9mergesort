def merge_sort_key(arr: list, inicio: int, fin: int, key) -> None:
    """
    Merge Sort estable para cualquier tipo de dato usando una función key.
    La estabilidad se mantiene porque en merge_key usamos <= en empates.
    """
    if inicio >= fin:
        return

    medio = (inicio + fin) // 2
    merge_sort_key(arr, inicio, medio, key)
    merge_sort_key(arr, medio + 1, fin, key)
    merge_key(arr, inicio, medio, fin, key)


def merge_key(arr: list, inicio: int, medio: int, fin: int, key) -> None:
    """Fusiona dos subarreglos ordenados comparando por key(item)."""
    izquierda = arr[inicio:medio + 1]
    derecha = arr[medio + 1:fin + 1]

    i = 0
    j = 0
    k = inicio

    while i < len(izquierda) and j < len(derecha):
        # <= mantiene estabilidad: si key es igual, se elige el de la izquierda
        if key(izquierda[i]) <= key(derecha[j]):
            arr[k] = izquierda[i]
            i += 1
        else:
            arr[k] = derecha[j]
            j += 1
        k += 1

    while i < len(izquierda):
        arr[k] = izquierda[i]
        i += 1
        k += 1

    while j < len(derecha):
        arr[k] = derecha[j]
        j += 1
        k += 1


