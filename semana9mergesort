# COMPRENDE-1: ¿Qué propiedad garantiza que merge() siempre
#              produce un subarreglo ordenado?
# el ciclo de fusion (while)

# COMPRENDE-2: ¿Por qué el árbol de recursión tiene altura log₂(n)
#              y qué implica eso para la complejidad total?
# por que cada llamada recursiva divide el arreglo en mitades


def merge_sort(arr: list, inicio: int, fin: int) -> None:
    """
    Ordena arr[inicio..fin] usando Merge Sort.
    DECISIÓN: [¿Por qué usamos índices inicio/fin en lugar de
               slicing y retornar un nuevo arreglo?]

    Por que usar slicing consta de trabajar con copias de la lista anterior lo cual lo haria mas costoso
    """
    if inicio >= fin:
        return  # Caso base: 0 o 1 elemento ya está ordenado

    medio = (inicio + fin) // 2
    merge_sort(arr, inicio, medio)
    merge_sort(arr, medio + 1, fin)
    merge(arr, inicio, medio, fin)


def merge(arr: list, inicio: int, medio: int, fin: int) -> None:
    """
    Fusiona dos subarreglos ordenados: arr[inicio..medio] y arr[medio+1..fin].
    DECISIÓN: [¿Por qué copiamos en arreglos auxiliares antes de fusionar?]

    eso es porque durante la fusion sobreescribiremos el arreglo
    """
    izquierda = arr[inicio:medio + 1]
    derecha = arr[medio + 1:fin + 1]

    i = 0
    j = 0
    k = inicio

    while i < len(izquierda) and j < len(derecha):
        # DECISIÓN: [¿Por qué usamos <= y no < ?
        #            ¿Qué efecto tiene sobre la estabilidad?]
        # Se usa <= para que, si son iguales, se elija primero el de la izquierda.
        # Eso conserva el orden relativo de empates (estabilidad).
        if izquierda[i] <= derecha[j]:
            arr[k] = izquierda[i]
            i += 1
        else:
            arr[k] = derecha[j]
            j += 1
        k += 1

    # copiar elementos restantes de izquierda
    while i < len(izquierda):
        arr[k] = izquierda[i]
        i += 1
        k += 1

    # copiar elementos restantes de derecha (BUG CORREGIDO)
    while j < len(derecha):
        arr[k] = derecha[j]
        j += 1
        k += 1


